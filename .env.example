# Optional Supabase Integration (Guest mode works out of the box without keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Colyseus Game Server WebSocket Endpoint
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# Diwali Cam: LiveKit Cloud / SFU Video Streaming (Optional: Peer WebRTC fallback works automatically without keys)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

